<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Калькулятор чаевых" 
        Height="707" 
        Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   Text="Калькулятор чаевых" 
                   FontSize="18" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <!-- Сумма счета -->
        <TextBlock Grid.Row="1" 
                   Text="Сумма счета (₽):" 
                   FontSize="13" 
                   FontWeight="Bold"
                   Margin="0,0,0,5"/>

        <TextBox x:Name="txtBillAmount" 
                 Grid.Row="2" 
                 FontSize="13" 
                 Height="35" 
                 Margin="0,0,0,15"
                 PreviewTextInput="NumberValidationTextBox"
                 Background="LightYellow"/>

        <!-- Количество гостей -->
        <TextBlock Grid.Row="3" 
                   Text="Количество гостей:" 
                   FontSize="13" 
                   FontWeight="Bold"
                   Margin="0,0,0,5"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBox x:Name="txtGuests" 
                     Text="1" 
                     Width="100" 
                     Height="35" 
                     FontSize="13"
                     PreviewTextInput="NumberValidationTextBox"
                     Background="LightYellow"/>
            <TextBlock Text="(для разделения счета)" 
                       Margin="10,8,0,0" 
                       FontSize="11" 
                       Foreground="Gray"/>
        </StackPanel>

        <!-- Выбор чаевых -->
        <TextBlock Grid.Row="5" 
                   Text="Выберите чаевые:" 
                   FontSize="13" 
                   FontWeight="Bold"
                   Margin="0,0,0,8"/>

        <Border Grid.Row="6" 
                BorderBrush="LightGray" 
                BorderThickness="1" 
                CornerRadius="8"
                Padding="15,10"
                Margin="0,0,0,15">
            <StackPanel>
                <RadioButton x:Name="rbNoTip" 
                             Content="Без чаевых (0%)" 
                             FontSize="13" 
                             Margin="0,5"
                             GroupName="TipGroup"/>
                <RadioButton x:Name="rbTip5" 
                             Content="5%" 
                             FontSize="13" 
                             Margin="0,5"
                             GroupName="TipGroup"/>
                <RadioButton x:Name="rbTip10" 
                             Content="10%" 
                             FontSize="13" 
                             Margin="0,5"
                             GroupName="TipGroup"
                             IsChecked="True"/>
                <RadioButton x:Name="rbTip15" 
                             Content="15%" 
                             FontSize="13" 
                             Margin="0,5"
                             GroupName="TipGroup"/>
            </StackPanel>
        </Border>

        <!-- Кнопка Рассчитать -->
        <Button x:Name="btnCalculate" 
                Grid.Row="7" 
                Content="Рассчитать" 
                Height="45" 
                FontSize="15" 
                FontWeight="Bold"
                Background="#2196F3" 
                Foreground="White"
                Margin="0,0,0,20"
                Cursor="Hand"
                Click="BtnCalculate_Click"/>

        <!-- Результат -->
        <GroupBox Grid.Row="8" 
                  Header=" РЕЗУЛЬТАТ" 
                  Margin="0,5,0,0"
                  FontWeight="Bold">
            <Border Background="#F5F5F5" CornerRadius="5" Padding="10">
                <ScrollViewer MaxHeight="200" 
                              VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="lblResult" 
                               FontFamily="Consolas" 
                               FontSize="12" 
                               TextWrapping="Wrap"
                               Foreground="#333333"/>
                </ScrollViewer>
            </Border>
        </GroupBox>
    </Grid>
</Window>